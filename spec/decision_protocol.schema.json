{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guilhermemichael/WordRules/blob/main/spec/decision_protocol.schema.json",
  "title": "WordRules Decision Protocol",
  "type": "object",
  "required": [
    "protocol_id",
    "protocol_version",
    "authority_precedence",
    "state_machine",
    "task_classes",
    "risk_levels",
    "action_policy",
    "untrusted_input_policy",
    "evidence_statuses",
    "reporting_contract",
    "symbolic_encoding_policy"
  ],
  "properties": {
    "protocol_id": {
      "const": "wordrules.ultra_master.decision_protocol"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "authority_precedence": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "state_machine": {
      "type": "object",
      "required": [
        "states",
        "normal_path",
        "transitions"
      ]
    },
    "task_classes": {
      "type": "object",
      "minProperties": 1
    },
    "risk_levels": {
      "type": "object",
      "required": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "action_policy": {
      "type": "object"
    },
    "untrusted_input_policy": {
      "type": "object"
    },
    "evidence_statuses": {
      "type": "object",
      "required": [
        "PASS",
        "FAIL",
        "NOT_VERIFIED",
        "NOT_APPLICABLE",
        "NOT_RUN",
        "BLOCKED",
        "DISCREPANCY",
        "OPEN"
      ]
    },
    "reporting_contract": {
      "type": "object",
      "required": [
        "required_fields",
        "rule"
      ]
    },
    "symbolic_encoding_policy": {
      "type": "object",
      "required": [
        "supported",
        "binary_encoding",
        "authority"
      ]
    }
  }
}
